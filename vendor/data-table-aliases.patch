diff --git a/src/core/Aliases.ts b/src/core/Aliases.ts
new file mode 100644
index 00000000..1066e4d3
--- /dev/null
+++ b/src/core/Aliases.ts
@@ -0,0 +1,112 @@
+import { ConfigurationError } from './errors';
+import type { DataType } from './types';
+
+/** Scalar values that may be assigned a presentation-only label. */
+export type AliasValue = string | number | boolean | bigint | Date | null;
+
+/** One raw value to display-label mapping. */
+export interface ValueAlias {
+  value: AliasValue;
+  label: string;
+}
+
+/** Presentation-only aliases keyed by raw column name. */
+export interface DataTableAliases {
+  columns?: Readonly<Record<string, string>>;
+  values?: Readonly<Record<string, readonly ValueAlias[]>>;
+}
+
+function aliasKey(value: AliasValue): string {
+  if (value === null) return 'null:';
+  if (value instanceof Date) return `date:${value.getTime()}`;
+  if (typeof value === 'number') {
+    if (Number.isNaN(value)) return 'number:NaN';
+    if (Object.is(value, -0)) return 'number:-0';
+  }
+  return `${typeof value}:${String(value)}`;
+}
+
+function isAliasValue(value: unknown): value is AliasValue {
+  return (
+    value === null ||
+    value instanceof Date ||
+    typeof value === 'string' ||
+    typeof value === 'number' ||
+    typeof value === 'boolean' ||
+    typeof value === 'bigint'
+  );
+}
+
+/** Immutable alias lookup shared by presentation components. */
+export class AliasResolver {
+  private readonly columns = new Map<string, string>();
+  private readonly values = new Map<string, Map<string, string>>();
+  private readonly dateValueColumns = new Set<string>();
+
+  constructor(config?: DataTableAliases) {
+    if (!config) return;
+    for (const [column, label] of Object.entries(config.columns ?? {})) {
+      if (typeof label !== 'string') this.invalid(`Column alias for "${column}" must be a string.`);
+      this.columns.set(column, label);
+    }
+    for (const [column, entries] of Object.entries(config.values ?? {})) {
+      if (!Array.isArray(entries)) this.invalid(`Value aliases for "${column}" must be an array.`);
+      const lookup = new Map<string, string>();
+      for (const entry of entries) {
+        if (!entry || typeof entry !== 'object' || typeof entry.label !== 'string') {
+          this.invalid(`Every value alias for "${column}" must have a string label.`);
+        }
+        if (
+          !isAliasValue(entry.value) ||
+          (entry.value instanceof Date && Number.isNaN(entry.value.getTime()))
+        ) {
+          this.invalid(`Value aliases for "${column}" must use a supported scalar value.`);
+        }
+        const key = aliasKey(entry.value);
+        if (lookup.has(key)) {
+          this.invalid(
+            `Duplicate value alias for column "${column}" and value ${String(entry.value)}.`,
+          );
+        }
+        lookup.set(key, entry.label);
+        if (entry.value instanceof Date) this.dateValueColumns.add(column);
+      }
+      this.values.set(column, lookup);
+    }
+  }
+
+  column(columnName: string): string {
+    return this.columns.get(columnName) ?? columnName;
+  }
+
+  value(columnName: string, value: unknown, type?: DataType): string | undefined {
+    const lookup = this.values.get(columnName);
+    if (!lookup) return undefined;
+    if (value === undefined) return lookup.get(aliasKey(null));
+    if (
+      value === null ||
+      typeof value === 'string' ||
+      typeof value === 'number' ||
+      typeof value === 'boolean' ||
+      typeof value === 'bigint' ||
+      value instanceof Date
+    ) {
+      const direct = lookup.get(aliasKey(value));
+      if (direct !== undefined) return direct;
+      if (type === 'date' || type === 'timestamp' || this.dateValueColumns.has(columnName)) {
+        const date =
+          typeof value === 'number' || typeof value === 'bigint'
+            ? new Date(Number(value))
+            : typeof value === 'string'
+              ? new Date(value)
+              : null;
+        if (date && !Number.isNaN(date.getTime())) return lookup.get(aliasKey(date));
+      }
+    }
+    return undefined;
+  }
+
+  private invalid(message: string): never {
+    throw new ConfigurationError(message, { code: 'OPTIONS_INVALID' });
+  }
+}
