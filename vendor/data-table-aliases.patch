diff --git a/tests/nih-merge/aliases.test.ts b/tests/nih-merge/aliases.test.ts
new file mode 100644
index 00000000..f817e2e5
--- /dev/null
+++ b/tests/nih-merge/aliases.test.ts
@@ -0,0 +1,189 @@
+/** @vitest-environment jsdom */
+import { afterAll, afterEach, beforeAll, describe, expect, it, vi } from 'vitest';
+import { AliasResolver } from '../../src/core/Aliases';
+import { CellRenderer } from '../../src/table/Cell';
+import { formatFilter } from '../../src/filters/FilterChip';
+import { exportFromState } from '../../src/export/CSVExport';
+import { exportJSONFromState } from '../../src/export/JSONExport';
+import { createDataTable, type DataTable, type DataTableAliases } from '../../src/index';
+import { createNodeDuckDB, type NodeDuckDBHarness } from '../helpers/duckdbNode';
+import { makeNodeBridge } from '../helpers/nodeBridge';
+
+const aliases: DataTableAliases = {
+  columns: { grp: 'Study Group', score: 'Score' },
+  values: {
+    grp: [
+      { value: 'A', label: '<b>Group A</b>' },
+      { value: 'B', label: 'Group B' },
+    ],
+  },
+};
+
+describe('NIH-MERGE presentation aliases', () => {
+  it('distinguishes scalar types, handles dates and nulls, and preserves empty labels', () => {
+    const date = new Date('2020-01-01T00:00:00Z');
+    const resolver = new AliasResolver({
+      values: {
+        x: [
+          { value: '1', label: 'text' },
+          { value: 1, label: 'number' },
+          { value: 1n, label: 'bigint' },
+          { value: true, label: 'boolean' },
+          { value: null, label: 'missing' },
+          { value: date, label: 'date' },
+          { value: '', label: '' },
+        ],
+      },
+    });
+    for (const [value, label] of [
+      ['1', 'text'],
+      [1, 'number'],
+      [1n, 'bigint'],
+      [true, 'boolean'],
+      [null, 'missing'],
+      [undefined, 'missing'],
+      [date.getTime(), 'date'],
+      ['', ''],
+    ]) {
+      expect(resolver.value('x', value)).toBe(label);
+    }
+    expect(resolver.value('x', '2020-01-01', 'date')).toBe('date');
+    expect(resolver.column('unmapped')).toBe('unmapped');
+    expect(resolver.value('x', 'unmapped')).toBeUndefined();
+    expect(
+      () =>
+        new AliasResolver({
+          values: {
+            x: [
+              { value: 1, label: 'one' },
+              { value: 1, label: 'duplicate' },
+            ],
+          },
+        }),
+    ).toThrow('Duplicate value alias');
+  });
+
+  it('renders labels as literal text, clears recycled cells, and keeps chips on raw filters', () => {
+    const resolver = new AliasResolver(aliases);
+    const renderer = new CellRenderer({ aliases: resolver });
+    const cell = document.createElement('div');
+    const schema = { name: 'grp', type: 'string', originalType: 'VARCHAR' } as const;
+    renderer.render(cell, 'A', schema);
+    expect(cell.textContent).toBe('<b>Group A</b>');
+    expect(cell.querySelector('b')).toBeNull();
+    renderer.render(cell, 'unmapped', schema);
+    expect(cell.textContent).toBe('unmapped');
+    const filter = { type: 'point', column: 'grp', value: 'A' } as const;
+    expect(formatFilter(filter, undefined, {}, resolver)).toEqual({
+      column: 'Study Group',
+      description: '= <b>Group A</b>',
+    });
+    expect(filter).toEqual({ type: 'point', column: 'grp', value: 'A' });
+  });
+});
+
+let harness: NodeDuckDBHarness;
+const tables: DataTable[] = [];
+const originalHeight = Object.getOwnPropertyDescriptor(HTMLElement.prototype, 'clientHeight');
+beforeAll(async () => {
+  vi.stubGlobal(
+    'ResizeObserver',
+    class {
+      observe() {}
+      unobserve() {}
+      disconnect() {}
+    },
+  );
+  Object.defineProperty(HTMLElement.prototype, 'clientHeight', {
+    configurable: true,
+    get: () => 500,
+  });
+  harness = await createNodeDuckDB();
+}, 30_000);
+afterEach(async () => {
+  for (const table of tables.splice(0)) await table.destroy();
+  document.body.replaceChildren();
+});
+afterAll(async () => {
+  await harness?.cleanup();
+  if (originalHeight) Object.defineProperty(HTMLElement.prototype, 'clientHeight', originalHeight);
+  else Reflect.deleteProperty(HTMLElement.prototype, 'clientHeight');
+  vi.unstubAllGlobals();
+});
+
+it('threads aliases through the facade and recreated headers/cells, retaining raw filtering, sorting and exports', async () => {
+  const host = document.createElement('div');
+  document.body.append(host);
+  const bridge = Object.assign(makeNodeBridge(harness.conn, harness.db), {
+    initialize: async () => {},
+    isInitialized: () => true,
+    clearQueryCache: () => {},
+    terminate: () => {},
+    dropTable: async (name: string) => {
+      await harness.conn.query(`DROP TABLE IF EXISTS "${name}"`);
+    },
+  });
+  const table = await createDataTable({
+    container: host,
+    bridge,
+    aliases,
+    source: 'grp,score\nA,2\nB,1\nA,3',
+    sourceFormat: 'csv',
+    tableName: 'nih_aliases',
+    persistence: false,
+    presets: false,
+    undoRedo: false,
+    expressionFilter: false,
+    exportDialog: false,
+  });
+  tables.push(table);
+  expect(host.querySelector('[data-column="grp"] .dt-col-name')?.textContent).toBe('Study Group');
+  await vi.waitFor(() =>
+    expect(host.querySelector('.dt-cell')?.textContent).toBe('<b>Group A</b>'),
+  );
+  const grpHeader = () =>
+    table.container.getColumnHeaders().find((header) => header.getColumn().name === 'grp')!;
+  expect(
+    grpHeader()
+      .getControls()
+      .some((el) => el.getAttribute('aria-label')?.includes('Study Group')),
+  ).toBe(true);
+  const viz = table.container
+    .getColumnHeaders()
+    .find((header) => header.getColumn().name === 'grp')!;
+  expect(viz.getElement().getAttribute('data-column')).toBe('grp');
+  table.actions.hideColumn('grp');
+  expect([...host.querySelectorAll('.dt-hidden-chip-name')].map((el) => el.textContent)).toContain(
+    'Study Group',
+  );
+  table.actions.showColumn('grp');
+  expect(grpHeader().getElement().querySelector('.dt-col-name')?.textContent).toBe('Study Group');
+  const counted = new Promise<void>((resolve) => {
+    const off = table.on('filterChange', () => {
+      off();
+      resolve();
+    });
+  });
+  table.actions.addFilter({ type: 'point', column: 'grp', value: 'A' });
+  await counted;
+  expect(table.state.filteredRows.get()).toBe(2);
+  expect(host.querySelector('.dt-filter-chip')?.textContent).toContain('<b>Group A</b>');
+  expect(host.querySelector('.dt-filter-chip b')).toBeNull();
+  table.actions.toggleSort('score');
+  const csv = await exportFromState(table.state, bridge, {
+    scope: 'filtered',
+    columns: ['grp', 'score'],
+    includeHeaders: true,
+  });
+  expect(csv.trim().split('\n')).toEqual(['grp,score', 'A,2', 'A,3']);
+  const json = await exportJSONFromState(table.state, bridge, {
+    scope: 'filtered',
+    columns: ['grp', 'score'],
+    format: 'array',
+  });
+  expect(JSON.parse(json)).toEqual([
+    { grp: 'A', score: 2 },
+    { grp: 'A', score: 3 },
+  ]);
+  expect(table.state.schema.get().map((col) => col.name)).toContain('grp');
+}, 30_000);
